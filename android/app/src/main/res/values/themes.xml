<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="bg">#FF141414</color>
    <color name="surface">#FF1E1E1E</color>
    <color name="line">#FF2E2E2E</color>
    <color name="text">#FFEDEAE4</color>
    <color name="muted">#FF8C8A85</color>
    <color name="accent">#FFE8A33D</color>
    <color name="danger">#FFE5534B</color>
    <color name="ok">#FF6CC17A</color>

    <style name="Theme.Droidmcp" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/muted</item>
    </style>

    <style name="Section">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/section</item>
        <item name="android:padding">16dp</item>
        <item name="android:layout_marginTop">12dp</item>
    </style>

    <style name="Label">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <style name="Body">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">13sp</item>
        <item name="android:layout_marginTop">6dp</item>
    </style>

    <style name="Mono">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textIsSelectable">true</item>
        <item name="android:layout_marginTop">8dp</item>
    </style>

    <style name="TextButton" parent="android:Widget.Material.Button.Borderless">
        <item name="android:textColor">@color/accent</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">16dp</item>
        <!-- No locale-dependent upper-casing (Turkish turns "i" into "İ"). -->
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Toggle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">48dp</item>
    </style>
</resources>
