<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Loopback HTTP to the daemon's /shutdown endpoint. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".app.DroidMcpApp"
        android:allowBackup="false"
        android:label="droidmcp"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Droidmcp">

        <activity
            android:name=".app.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Daemon lifecycle broadcasts. Only senders holding DUMP (the shell,
             not ordinary apps) may deliver them, so no app can hide the kill switch. -->
        <receiver
            android:name=".app.StatusReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <!-- Target of the notification's Stop action only. -->
        <receiver
            android:name=".app.StopReceiver"
            android:exported="false" />
    </application>

</manifest>
