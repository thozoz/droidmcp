<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Loopback HTTP to the daemon's /shutdown endpoint. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:label="droidmcp"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- Daemon lifecycle broadcasts. Only senders holding DUMP (the shell,
             not ordinary apps) may deliver them, so no app can hide the kill switch. -->
        <receiver
            android:name=".app.StatusReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <!-- Target of the notification's Stop action only. -->
        <receiver
            android:name=".app.StopReceiver"
            android:exported="false" />
    </application>

</manifest>
